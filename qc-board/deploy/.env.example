# deploy/.env にコピーして値を埋める(このファイルは Git に入れない)
# 公開するドメイン(Route 53 などで EC2 の固定 IP に A レコードを向けておく)
QC_DOMAIN=qc-board.example.com
# アクセスを許す IP(空白区切り)。全開放は "0.0.0.0/0 ::/0"。社内の固定 IP だけにするのを推奨
QC_ALLOW_IPS=0.0.0.0/0 ::/0
# Mission Bridge 埋め込みの共有鍵(16 文字以上。使わなければ空)
QC_EMBED_KEY=
# 完了・取消から何日でボードから外すか(0 で無効)
QC_AUTO_ARCHIVE_DAYS=14
# バックアップ世代と間隔
QC_BACKUP_KEEP=30
QC_BACKUP_INTERVAL_HOURS=24
# kintone を繋がずに試すとき 1
KINTONE_MOCK=0
