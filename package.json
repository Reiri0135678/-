{
  "name": "qc-board",
  "version": "0.8.0",
  "description": "品質管理室 検査依頼デジタル化アプリ(多人数同時編集ホワイトボード)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test:e2e": "node scripts/e2e-sync.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "konva": "^10.3.3",
    "lib0": "^0.2.117",
    "pdfjs-dist": "^6.3.289",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.6",
    "tsx": "^4.23.13",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "playwright-core": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
