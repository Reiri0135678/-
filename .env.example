# ---- BFF (server) ----
# mock: kintone なしでローカル JSON に保存（開発・デモ用）
# kintone: 実際の kintone に接続
KINTONE_MODE=mock
PORT=3000

# KINTONE_MODE=kintone のときのみ必要。値は推測で書かず管理者から受け取る。
KINTONE_BASE_URL=https://example.cybozu.com
KINTONE_APP_ID=
KINTONE_API_TOKEN=

# mock モードの保存先（省略時 server/data/posts.json）
MOCK_DATA_FILE=
